{
  "$id": "https://cortex.security/schemas/assurance_manifest_v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cortex Assurance Manifest Schema",
  "description": "Normative schema defining the canonical structure of the Cortex Assurance Manifest.",
  "type": "object",
  "required": [
