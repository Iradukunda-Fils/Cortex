    "manifest_version",
    "generated_at",
    "last_verified_commit",
    "repository",
    "overall_status",
    "formal_baseline",
    "certification_accounting",
    "claims"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "manifest_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "last_verified_commit": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "overall_status": {
      "type": "object"
    },
    "formal_baseline": {
      "type": "object"
    },
    "certification_accounting": {
      "type": "object"
    },
    "claims": {
      "type": "array"
    }
  },
  "additionalProperties": false
